  <main>
    <!-- HERO SECTION -->
    <section class="hero-section" id="home">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="pulse-dot"></span>
            <span>Trusted Nairobi Dental Specialists • 25+ Years Legacy</span>
          </div>
          <h1 class="hero-title">
            Bring Back Your Smile with <span class="gradient-text">Expert Care</span>
          </h1>
          <p class="hero-description">
            Looking for a reliable, painless dental clinic in Nairobi? At <strong>Deans Dental Care</strong>, we specialize in advanced restorative, orthodontic braces, pediatric dentistry, and cosmetic smile makeovers. Visit our state-of-the-art clinics at <strong>Garden City Mall</strong> and <strong>Runda Mall</strong>.
          </p>

          <div class="hero-cta-group">
            <button type="button" class="btn btn-primary btn-lg open-booking-btn" data-modal="bookingModal">
              <i class="icon-calendar"></i> Book Your Appointment
            </button>
            <a href="#services" class="btn btn-light btn-lg">
              <i class="icon-sparkles"></i> Explore Services
            </a>
          </div>

          <!-- Hero Metrics & Trust Signals -->
          <div class="hero-metrics">
            <div class="metric-item">
              <div class="metric-number">25+</div>
              <div class="metric-label">Years of Experience</div>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-item">
              <div class="metric-number">20K+</div>
              <div class="metric-label">Happy Confident Smiles</div>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-item">
              <div class="metric-number">100%</div>
              <div class="metric-label">KMPDC Licensed Care</div>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-card-wrapper">
            <img 
              src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1000&q=80" 
              alt="Professional Dental Care at Deans Dental Clinic" 
              class="hero-main-img" 
            />
            
            <!-- Floating Trust Badge 1: 5.0 Star Reviews -->
            <div class="floating-badge badge-reviews">
              <div class="star-row">
                ★★★★★
              </div>
              <div class="badge-text">
                <strong>5.0 / 5.0 Rating</strong>
                <span>From 650+ Nairobi Patients</span>
              </div>
            </div>

            <!-- Floating Trust Badge 2: Pain-free guarantee -->
            <div class="floating-badge badge-painfree">
              <div class="badge-icon-wrap">
                <i class="icon-heart-pulse"></i>
              </div>
              <div>
                <strong>Painless & Gentle</strong>
                <span>Advanced sedation & care</span>
              </div>
            </div>

            <!-- Floating Trust Badge 3: Direct Insurance -->
            <div class="floating-badge badge-insurance">
              <i class="icon-shield-check"></i>
              <span>Direct Insurance Billing</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- QUICK HIGHLIGHTS / WORKING HOURS / EMERGENCY BANNER -->
    <section class="quick-highlights-section">
      <div class="container">
        <div class="highlights-grid">
          <!-- Card 1: Working Hours -->
          <div class="highlight-card">
            <div class="highlight-icon">
              <i class="icon-clock"></i>
            </div>
            <div class="highlight-content">
              <h3>Working Hours</h3>
              <p class="highlight-time"><strong>Mon – Sat:</strong> 8:00 AM – 8:00 PM</p>
              <p class="highlight-time"><strong>Sunday:</strong> 10:00 AM – 4:00 PM</p>
              <span class="badge-status open-now"><span class="indicator"></span> Open Today</span>
            </div>
          </div>

          <!-- Card 2: Book Appointment -->
          <div class="highlight-card highlight-card-featured">
            <div class="highlight-icon">
              <i class="icon-calendar-check"></i>
            </div>
            <div class="highlight-content">
              <h3>Fast Online Booking</h3>
              <p>Choose your preferred date, branch (Garden City or Runda), and specialist in seconds.</p>
              <button type="button" class="btn btn-white btn-sm open-booking-btn" data-modal="bookingModal">
                Select Date & Time &rarr;
              </button>
            </div>
          </div>

          <!-- Card 3: 24/7 Emergency Line -->
          <div class="highlight-card">
            <div class="highlight-icon emergency-icon">
              <i class="icon-ambulance"></i>
            </div>
            <div class="highlight-content">
              <h3>24/7 Emergency Dental Care</h3>
              <p>Severe toothache, broken tooth, or dental trauma? Call our emergency dentists immediately.</p>
              <a href="tel:+254703222228" class="emergency-phone-btn">
                <i class="icon-phone"></i> +254 703 222 228
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="about-section section-padding" id="about">
      <div class="container">
        <div class="about-grid">
          <div class="about-images">
            <div class="img-composition">
              <img 
                src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&w=800&q=80" 
                alt="Expert Dentist Examination" 
                class="about-img-1" 
              />
              <img 
                src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=600&q=80" 
                alt="Modern Clinic Facilities at Garden City Mall" 
                class="about-img-2" 
              />
              <div class="experience-card">
                <span class="exp-num">25+</span>
                <span class="exp-text">Years of Trusted Clinical Practice</span>
              </div>
            </div>
          </div>

          <div class="about-text-content">
            <div class="section-tag">About Deans Dental Care</div>
            <h2 class="section-title">
              Trusted Family Dental Care Across <span class="highlight">Nairobi</span>
            </h2>
            <p class="lead-text">
              With a legacy spanning over two decades and more than 20,000 radiant smiles restored, Deans Dental Care has earned the trust of families and professionals all across Nairobi.
            </p>
            <p>
              Our KMPDC-licensed dental surgeons provide a full spectrum of world-class oral health services—from gentle pediatric care that keeps children smiling, to sophisticated orthodontic braces, dental implants, and emergency toothache relief.
            </p>

            <div class="features-checklist">
              <div class="check-item">
                <div class="check-icon"><i class="icon-check"></i></div>
                <div>
                  <strong>Modern Digital Technology</strong>
                  <p>Low-radiation 3D imaging, digital intraoral scanning, and precision rotary equipment.</p>
                </div>
              </div>
              <div class="check-item">
                <div class="check-icon"><i class="icon-check"></i></div>
                <div>
                  <strong>Gentle-First & Anxiety-Free</strong>
                  <p>Painless numbing, soothing environment, and compassionate dental specialists.</p>
                </div>
              </div>
              <div class="check-item">
                <div class="check-icon"><i class="icon-check"></i></div>
                <div>
                  <strong>Executive Priority Scheduling</strong>
                  <p>Tailored appointments for busy professionals in CBD, Westlands, Upper Hill, and Thika Rd.</p>
                </div>
              </div>
              <div class="check-item">
                <div class="check-icon"><i class="icon-check"></i></div>
                <div>
                  <strong>Direct Insurance Claims</strong>
                  <p>Accepted across major Kenyan providers with hassle-free electronic verification.</p>
                </div>
              </div>
            </div>

            <div class="neighborhoods-served">
              <span class="neighborhoods-label">Serving Communities:</span>
              <div class="neighborhood-tags">
                <span class="tag">Garden Estate</span>
                <span class="tag">Runda</span>
                <span class="tag">Muthaiga</span>
                <span class="tag">Westlands</span>
                <span class="tag">Parklands</span>
                <span class="tag">Ridgeways</span>
                <span class="tag">Thome</span>
                <span class="tag">Windsor</span>
                <span class="tag">Mirema</span>
                <span class="tag">Kasarani</span>
                <span class="tag">Roasters / TRM</span>
              </div>
            </div>

            <div class="about-action">
              <button type="button" class="btn btn-primary open-booking-btn" data-modal="bookingModal">
                Schedule a Consultation
              </button>
              <a href="tel:+254703222228" class="about-phone-link">
                <i class="icon-phone"></i> +254 703 222 228
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES SECTION -->
    <section class="services-section section-padding bg-alt" id="services">
      <div class="container">
        <div class="section-header text-center">
          <div class="section-tag">World-Class Oral Health</div>
          <h2 class="section-title">Comprehensive Dental Services</h2>
          <p class="section-subtitle">
            From routine preventative checkups to full smile transformations, our certified specialists deliver unmatched precision and comfort.
          </p>

          <!-- Service Filter Tabs -->
          <div class="service-tabs" role="tablist">
            <button type="button" class="tab-btn active" data-filter="all">All Treatments</button>
            <button type="button" class="tab-btn" data-filter="cosmetic">Cosmetic & Whitening</button>
            <button type="button" class="tab-btn" data-filter="orthodontics">Braces & Aligners</button>
            <button type="button" class="tab-btn" data-filter="restorative">Restorative & Implants</button>
            <button type="button" class="tab-btn" data-filter="general">General & Kids</button>
            <button type="button" class="tab-btn" data-filter="surgical">Surgical Care</button>
          </div>
        </div>

        <!-- Services Grid -->
        <div class="services-grid" id="servicesGrid">
          
          <!-- Service 1: Teeth Whitening -->
          <div class="service-card" data-category="cosmetic">
            <div class="service-img-wrap">
              <img src="https://images.unsplash.com/photo-1609840114035-3c981b782dfe?auto=format&fit=crop&w=600&q=80" alt="Professional Teeth Whitening Nairobi" class="service-img" />
              <span class="service-tag cosmetic">Cosmetic</span>
            </div>
            <div class="service-body">
              <div class="service-meta">
                <span class="meta-pill"><i class="icon-clock"></i> 45 - 60 mins</span>
                <span class="meta-pill pain-free"><i class="icon-smile"></i> 100% Painless</span>
              </div>
              <h3 class="service-title">Professional Teeth Whitening</h3>
              <p class="service-desc">
                Revitalize your smile with advanced in-office laser whitening and custom take-home kits for dramatic, long-lasting brightness up to 8 shades lighter.
              </p>
              <ul class="service-perks">
                <li><i class="icon-check"></i> In-Office Philips Zoom / Laser Treatment</li>
                <li><i class="icon-check"></i> Customized Sensitivity-Free Formula</li>
                <li><i class="icon-check"></i> Immediate visible results in 1 session</li>
              </ul>
              <div class="service-footer">
                <button type="button" class="btn btn-outline btn-sm book-service-btn" data-service="Professional Teeth Whitening">
                  Book Whitening &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- Service 2: Braces & Orthodontics -->
          <div class="service-card" data-category="orthodontics">
            <div class="service-img-wrap">
              <img src="https://images.unsplash.com/photo-1606811841689-23dfddce3e95?auto=format&fit=crop&w=600&q=80" alt="Affordable Dental Braces Nairobi" class="service-img" />
              <span class="service-tag ortho">Orthodontics</span>
            </div>
            <div class="service-body">
              <div class="service-meta">
                <span class="meta-pill"><i class="icon-calendar"></i> Monthly Follow-ups</span>
                <span class="meta-pill pain-free"><i class="icon-smile"></i> Kids & Adults</span>
              </div>
              <h3 class="service-title">Affordable Braces & Clear Aligners</h3>
              <p class="service-desc">
                Achieve aligned, confident teeth with modern metal braces, aesthetic ceramic braces, or discreet clear aligners (Invisalign) tailored to your lifestyle.
              </p>
              <ul class="service-perks">
                <li><i class="icon-check"></i> Traditional, Ceramic & Self-Ligating Braces</li>
                <li><i class="icon-check"></i> Invisible Clear Aligners (Invisalign)</li>
                <li><i class="icon-check"></i> Flexible monthly installment plans</li>
              </ul>
              <div class="service-footer">
                <button type="button" class="btn btn-outline btn-sm book-service-btn" data-service="Braces & Orthodontics">
                  Book Consultation &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- Service 3: Dental Implants -->
          <div class="service-card" data-category="restorative">
            <div class="service-img-wrap">
              <img src="https://images.unsplash.com/photo-1598256989800-fe5f95da9787?auto=format&fit=crop&w=600&q=80" alt="Dental Implants Nairobi" class="service-img" />
              <span class="service-tag restorative">Restorative</span>
            </div>
            <div class="service-body">
              <div class="service-meta">
                <span class="meta-pill"><i class="icon-shield"></i> Permanent Solution</span>
                <span class="meta-pill pain-free"><i class="icon-smile"></i> Natural Look & Feel</span>
              </div>
              <h3 class="service-title">Permanent Dental Implants</h3>
              <p class="service-desc">
                The gold standard for replacing missing teeth. Biocompatible titanium implants topped with custom porcelain crowns that look, chew, and feel just like natural teeth.
              </p>
              <ul class="service-perks">
                <li><i class="icon-check"></i> Single tooth, multi-tooth & full-arch</li>
                <li><i class="icon-check"></i> 3D CT Guided surgical placement</li>
                <li><i class="icon-check"></i> Prevents bone loss & facial sagging</li>
              </ul>
              <div class="service-footer">
                <button type="button" class="btn btn-outline btn-sm book-service-btn" data-service="Dental Implants">
                  Book Implant Consult &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- Service 4: Routine Dental Cleaning -->
          <div class="service-card" data-category="general">
            <div class="service-img-wrap">
              <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&w=600&q=80" alt="Routine Dental Cleaning Scaling Nairobi" class="service-img" />
              <span class="service-tag general">General</span>
            </div>
            <div class="service-body">
              <div class="service-meta">
                <span class="meta-pill"><i class="icon-clock"></i> 30 - 45 mins</span>
                <span class="meta-pill pain-free"><i class="icon-smile"></i> Gentle Ultrasonic</span>
              </div>
              <h3 class="service-title">Dental Cleaning & Polishing</h3>
              <p class="service-desc">
                Professional ultrasonic plaque, tartar, and coffee/tea stain removal followed by fluoride protection to protect gums and preserve pristine breath.
              </p>
              <ul class="service-perks">
                <li><i class="icon-check"></i> Ultrasonic scaling without scraping pain</li>
                <li><i class="icon-check"></i> Comprehensive oral cancer screening</li>
                <li><i class="icon-check"></i> Prevents gingivitis & periodontitis</li>
              </ul>
              <div class="service-footer">
                <button type="button" class="btn btn-outline btn-sm book-service-btn" data-service="Dental Cleaning & Scaling">
                  Book Cleaning &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- Service 5: Painless Root Canal -->
          <div class="service-card" data-category="restorative">
            <div class="service-img-wrap">
              <img src="https://images.unsplash.com/photo-1629909615184-74f495363b67?auto=format&fit=crop&w=600&q=80" alt="Root Canal Treatment Nairobi" class="service-img" />
              <span class="service-tag restorative">Endodontics</span>
            </div>
            <div class="service-body">
              <div class="service-meta">
                <span class="meta-pill"><i class="icon-clock"></i> 60 mins</span>
                <span class="meta-pill pain-free"><i class="icon-smile"></i> 100% Painless Numbing</span>
              </div>
              <h3 class="service-title">Painless Root Canal Therapy</h3>
              <p class="service-desc">
                Save infected or severely aching teeth from extraction. Using computerized rotary instruments, we relieve throbbing pain quickly and preserve your natural tooth structure.
              </p>
              <ul class="service-perks">
                <li><i class="icon-check"></i> Immediate relief from tooth nerve pain</li>
                <li><i class="icon-check"></i> Rotary endodontics for precision speed</li>
                <li><i class="icon-check"></i> Reinforced with durable crown protection</li>
              </ul>
              <div class="service-footer">
                <button type="button" class="btn btn-outline btn-sm book-service-btn" data-service="Root Canal Treatment">
                  Relieve Tooth Pain &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- Service 6: Pediatric Dental Care -->
          <div class="service-card" data-category="general">
            <div class="service-img-wrap">
              <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=600&q=80" alt="Pediatric Dentist Nairobi Garden City" class="service-img" />
              <span class="service-tag general">Pediatric</span>
            </div>
            <div class="service-body">
              <div class="service-meta">
                <span class="meta-pill"><i class="icon-heart"></i> Child Friendly</span>
                <span class="meta-pill pain-free"><i class="icon-smile"></i> Anxiety-Free</span>
              </div>
              <h3 class="service-title">Pediatric & Kids Dental Care</h3>
              <p class="service-desc">
                Building healthy dental habits early with our "gentle-first" approach. We make visits fun and fearless for toddlers, children, and teens with gentle sealants and exams.
              </p>
              <ul class="service-perks">
                <li><i class="icon-check"></i> Cavity prevention sealants & fluoride</li>
                <li><i class="icon-check"></i> Friendly gentle pediatric specialists</li>
                <li><i class="icon-check"></i> Habit correction (thumb sucking, tongue thrust)</li>
              </ul>
              <div class="service-footer">
                <button type="button" class="btn btn-outline btn-sm book-service-btn" data-service="Pediatric Dental Care">
                  Book for Kids &rarr;
                </button>
              </div>
            </div>
          </div>

          <!-- Service 7: Porcelain Veneers & Crowns -->
          <div class="service-card" data-category="cosmetic">
