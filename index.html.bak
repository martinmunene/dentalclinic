  <!-- FLOATING ACTION BUTTONS -->
  <div class="floating-actions">
    <a href="https://wa.me/254703222228?text=Hello%20Deans%20Dental,%20I%20would%20like%20to%20inquire%20about%20dental%20services" target="_blank" rel="noopener" class="float-btn float-whatsapp" aria-label="Chat on WhatsApp">
      <i class="icon-whatsapp"></i>
