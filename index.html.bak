  <!-- INTERACTIVE APPOINTMENT BOOKING MODAL -->
  <div class="modal-backdrop" id="bookingModal">
    <div class="modal-dialog booking-modal-dialog">
      <div class="modal-header">
        <div class="modal-header-text">
          <h3 class="modal-title">Book an Appointment</h3>
          <p class="modal-subtitle">Deans Dental Clinic • Quick & Easy Scheduling</p>
        </div>
        <button type="button" class="modal-close" id="closeBookingModal">&times;</button>
      </div>

      <!-- Booking Wizard Steps Indicator -->
      <div class="wizard-steps">
        <div class="step-badge active" id="stepIndicator1"><span>1</span> Clinic & Service</div>
        <div class="step-badge" id="stepIndicator2"><span>2</span> Date & Time</div>
        <div class="step-badge" id="stepIndicator3"><span>3</span> Patient Details</div>
        <div class="step-badge" id="stepIndicator4"><span>4</span> Confirmation</div>
      </div>

      <div class="modal-body">
        <form id="bookingForm" novalidate>
          
          <!-- STEP 1: Branch & Service -->
          <div class="wizard-step active" id="wizardStep1">
            <h4 class="step-heading">1. Select Preferred Clinic & Service</h4>
            
            <label class="form-label">Choose Clinic Location:</label>
            <div class="branch-selector-grid">
              <label class="branch-option">
                <input type="radio" name="bookingBranch" value="Garden City Mall" checked />
                <div class="branch-option-card">
                  <strong>Garden City Mall</strong>
                  <span>2nd Floor, Next to KCB, Thika Road</span>
                </div>
              </label>
              <label class="branch-option">
                <input type="radio" name="bookingBranch" value="Runda Mall" />
                <div class="branch-option-card">
                  <strong>Runda Mall</strong>
                  <span>2nd Floor, Kiambu Road</span>
                </div>
              </label>
            </div>

            <div class="form-group mt-4">
              <label for="bookingService" class="form-label">Dental Service Required:</label>
              <select id="bookingService" class="form-select" required>
                <option value="" disabled selected>Select a treatment...</option>
                <optgroup label="Cosmetic Dentistry">
                  <option value="Professional Teeth Whitening">Professional Teeth Whitening</option>
                  <option value="Porcelain Veneers & Smile Design">Porcelain Veneers & Smile Design</option>
                  <option value="Dental Bonding">Dental Bonding & Aesthetic Fillings</option>
                </optgroup>
                <optgroup label="Orthodontics">
                  <option value="Affordable Metal Braces">Affordable Metal Braces</option>
                  <option value="Ceramic Tooth-Colored Braces">Ceramic Tooth-Colored Braces</option>
                  <option value="Clear Aligners (Invisalign)">Clear Aligners (Invisalign)</option>
                </optgroup>
                <optgroup label="General & Preventative">
                  <option value="Routine Dental Cleaning & Checkup">Routine Dental Cleaning & Checkup</option>
                  <option value="Pediatric Kids Dentistry">Pediatric / Kids Dentistry</option>
                  <option value="Toothache Diagnosis & Treatment">Toothache Diagnosis & Treatment</option>
                </optgroup>
                <optgroup label="Restorative & Surgery">
                  <option value="Permanent Dental Implants">Permanent Dental Implants</option>
                  <option value="Painless Root Canal Therapy">Painless Root Canal Therapy</option>
                  <option value="Wisdom Tooth Extraction">Wisdom Tooth Extraction</option>
                  <option value="Crowns & Bridges">Dental Crowns & Bridges</option>
                </optgroup>
              </select>
            </div>

            <div class="wizard-actions">
              <div></div>
              <button type="button" class="btn btn-primary next-step-btn" data-next="2">Next: Date & Time &rarr;</button>
            </div>
          </div>

          <!-- STEP 2: Date & Time Slot -->
          <div class="wizard-step" id="wizardStep2">
            <h4 class="step-heading">2. Choose Appointment Date & Time</h4>
            
            <div class="form-group">
              <label for="bookingDate" class="form-label">Select Preferred Date:</label>
              <input type="date" id="bookingDate" class="form-input" required />
            </div>

            <div class="form-group">
              <label class="form-label">Available Time Slots:</label>
              <div class="time-slots-grid" id="timeSlotsContainer">
                <!-- Dynamically generated time slot buttons -->
                <button type="button" class="time-slot-btn" data-time="09:00 AM">09:00 AM</button>
                <button type="button" class="time-slot-btn" data-time="10:00 AM">10:00 AM</button>
                <button type="button" class="time-slot-btn" data-time="11:30 AM">11:30 AM</button>
                <button type="button" class="time-slot-btn" data-time="02:00 PM">02:00 PM</button>
                <button type="button" class="time-slot-btn" data-time="03:30 PM">03:30 PM</button>
                <button type="button" class="time-slot-btn" data-time="05:00 PM">05:00 PM</button>
                <button type="button" class="time-slot-btn" data-time="06:30 PM">06:30 PM</button>
              </div>
              <input type="hidden" id="selectedTimeSlot" value="" required />
            </div>

            <div class="wizard-actions">
              <button type="button" class="btn btn-light prev-step-btn" data-prev="1">&larr; Back</button>
              <button type="button" class="btn btn-primary next-step-btn" data-next="3">Next: Patient Info &rarr;</button>
            </div>
          </div>

          <!-- STEP 3: Patient Information & Insurance -->
          <div class="wizard-step" id="wizardStep3">
            <h4 class="step-heading">3. Patient Information</h4>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="patientName" class="form-label">Full Name *</label>
                <input type="text" id="patientName" class="form-input" placeholder="e.g. Grace Njeri" required />
              </div>
              <div class="form-group col-half">
                <label for="patientPhone" class="form-label">Phone Number *</label>
                <input type="tel" id="patientPhone" class="form-input" placeholder="e.g. 0712 345 678" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="patientEmail" class="form-label">Email Address *</label>
                <input type="email" id="patientEmail" class="form-input" placeholder="e.g. grace@example.com" required />
              </div>
              <div class="form-group col-half">
                <label for="patientPayment" class="form-label">Payment Method / Insurance</label>
                <select id="patientPayment" class="form-select">
                  <option value="Self Pay / M-Pesa / Card">Self Pay / M-Pesa / Card</option>
                  <option value="AAR Insurance">AAR Insurance</option>
                  <option value="Jubilee Insurance">Jubilee Insurance</option>
                  <option value="CIC Group">CIC Group</option>
                  <option value="Britam">Britam</option>
                  <option value="APA Insurance">APA Insurance</option>
                  <option value="GA Insurance">GA Insurance</option>
                  <option value="Equity Bank Scheme">Equity Bank Scheme</option>
                  <option value="KCB Bank Scheme">KCB Bank Scheme</option>
                  <option value="Co-op Bank Scheme">Co-op Bank Scheme</option>
                  <option value="Madison Insurance">Madison Insurance</option>
                  <option value="Other Insurance">Other Corporate Cover</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="patientNotes" class="form-label">Special Notes or Dental Concerns (Optional):</label>
              <textarea id="patientNotes" class="form-textarea" rows="2" placeholder="e.g., Sensitive gums, emergency pain, first-time dental checkup..."></textarea>
            </div>

            <div class="wizard-actions">
              <button type="button" class="btn btn-light prev-step-btn" data-prev="2">&larr; Back</button>
              <button type="submit" class="btn btn-primary" id="submitBookingBtn">
                <i class="icon-check"></i> Confirm Appointment
              </button>
            </div>
          </div>

          <!-- STEP 4: Confirmation State -->
          <div class="wizard-step" id="wizardStep4">
            <div class="confirmation-success">
              <div class="success-icon-wrap">
                <i class="icon-check-big"></i>
              </div>
              <h3 class="success-title">Appointment Request Submitted!</h3>
              <p class="success-desc">
                Thank you for choosing Deans Dental Care. Your appointment request has been logged, and our front desk will verify your slot shortly via SMS/WhatsApp.
              </p>

              <div class="booking-summary-card" id="bookingSummaryCard">
                <!-- Injected via JavaScript -->
              </div>

              <div class="confirmation-actions">
                <a id="whatsappConfirmLink" href="#" target="_blank" rel="noopener" class="btn btn-whatsapp btn-block">
                  <i class="icon-whatsapp"></i> Send Instant Confirmation on WhatsApp
                </a>
                <button type="button" class="btn btn-light btn-block" id="finishBookingBtn">Done / Close</button>
              </div>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>

  <!-- INSURANCE VERIFIER MODAL -->
  <div class="modal-backdrop" id="insuranceModal">
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-header-text">
          <h3 class="modal-title">Insurance Coverage Verifier</h3>
          <p class="modal-subtitle">Check your dental benefits at Deans Dental Clinic</p>
        </div>
        <button type="button" class="modal-close" id="closeInsuranceModal">&times;</button>
      </div>
      <div class="modal-body">
        <form id="insuranceForm">
          <div class="form-group">
            <label class="form-label">Select Your Insurance Provider:</label>
            <select class="form-select" id="insProviderSelect" required>
              <option value="" disabled selected>Choose insurance...</option>
              <option value="AAR Insurance">AAR Insurance (Comprehensive Direct Billing)</option>
              <option value="Jubilee Insurance">Jubilee Insurance (Direct Direct Billing)</option>
              <option value="Britam">Britam (Comprehensive In & Outpatient)</option>
              <option value="CIC Group">CIC Group (Direct Direct Billing)</option>
              <option value="APA Insurance">APA Insurance (Direct Direct Billing)</option>
              <option value="GA Insurance">GA Insurance (Direct Direct Billing)</option>
              <option value="Equity Bank Scheme">Equity Bank Staff & Dependents</option>
              <option value="KCB Bank Scheme">KCB Bank Corporate Cover</option>
              <option value="Co-operative Bank">Co-operative Bank Scheme</option>
              <option value="Madison Insurance">Madison Insurance</option>
              <option value="Sedgwick Kenya">Sedgwick Kenya</option>
              <option value="Fidelity / MUA / Laser">Fidelity / MUA / Laser / Liaison</option>
              <option value="Other Provider">Other Corporate Provider</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Your Full Name:</label>
            <input type="text" class="form-input" id="insName" placeholder="e.g. John Kamau" required />
          </div>

          <div class="form-group">
            <label class="form-label">Mobile Number:</label>
            <input type="tel" class="form-input" id="insPhone" placeholder="0700 000 000" required />
          </div>

          <div class="form-group">
            <label class="form-label">Member / Policy Number (Optional):</label>
            <input type="text" class="form-input" id="insMemberNo" placeholder="e.g. POL-893214" />
          </div>

          <div class="form-group">
            <label class="form-label">Preferred Branch:</label>
            <select class="form-select" id="insBranch">
              <option value="Garden City Mall">Garden City Mall (Thika Road)</option>
              <option value="Runda Mall">Runda Mall (Kiambu Road)</option>
            </select>
          </div>

          <div class="modal-actions">
            <button type="submit" class="btn btn-primary btn-block">Verify Coverage Now</button>
          </div>
          <div id="insResultMsg" class="mt-3 text-center"></div>
        </form>
      </div>
    </div>
  </div>

  <!-- ARTICLE MODAL -->
  <div class="modal-backdrop" id="articleModal">
    <div class="modal-dialog article-modal-dialog">
      <div class="modal-header">
        <div class="modal-header-text">
          <span class="badge-pill" id="articleCategory">Article</span>
          <h3 class="modal-title mt-1" id="articleTitle">Article Title</h3>
        </div>
        <button type="button" class="modal-close" id="closeArticleModal">&times;</button>
      </div>
      <div class="modal-body" id="articleBody">
        <!-- Injected via JavaScript -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary open-booking-btn" data-modal="bookingModal">Book Consultation</button>
        <button type="button" class="btn btn-light" id="closeArticleBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- JavaScript -->
  <script src="js/app.js"></script>
</body>
