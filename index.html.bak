    <!-- FAQ SECTION -->
    <section class="faq-section section-padding bg-alt" id="faq">
      <div class="container">
        <div class="section-header text-center">
          <div class="section-tag">Got Questions?</div>
          <h2 class="section-title">Frequently Asked Dental Questions</h2>
          <p class="section-subtitle">Clear answers to help you feel completely comfortable before your visit.</p>
        </div>

        <div class="faq-accordion-wrap">
          <!-- FAQ 1 -->
          <div class="faq-item active">
            <button type="button" class="faq-question">
              <span>Will my dental treatment hurt?</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>
                Not at all. At Deans Dental Care, we pride ourselves on modern gentle dentistry. We use top-tier topical numbing gels, localized computerized anesthetics, and gentle techniques so procedures like root canals, extractions, and deep cleanings are completely painless and stress-free.
              </p>
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item">
            <button type="button" class="faq-question">
              <span>How do I use my health insurance at Deans Dental?</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>
                Simply bring your medical insurance card and national ID to your appointment. Our administrative team will verify your dental balance with your insurer (AAR, Jubilee, Britam, CIC, APA, GA, Equity, KCB, Madison, etc.) electronically, allowing direct cashless billing on covered procedures.
              </p>
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item">
            <button type="button" class="faq-question">
              <span>What is the difference between metal braces and clear aligners?</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>
                Metal braces are fixed orthodontic brackets bonded to teeth, ideal for complex alignments and budget-friendly treatments. Clear aligners (Invisalign) are custom, removable transparent trays that straighten teeth discreetly without visible metal. Both deliver outstanding functional and aesthetic alignment.
              </p>
            </div>
          </div>

          <!-- FAQ 4 -->
          <div class="faq-item">
            <button type="button" class="faq-question">
              <span>How long does in-office teeth whitening last?</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>
                Professional laser whitening results typically last 1 to 3 years, depending on your dietary habits (coffee, tea, red wine, smoking). We also supply maintenance touch-up pens and customized take-home trays to keep your teeth bright indefinitely.
              </p>
            </div>
          </div>

          <!-- FAQ 5 -->
          <div class="faq-item">
            <button type="button" class="faq-question">
              <span>What should I do in a sudden dental emergency?</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>
                If you suffer acute tooth pain, trauma, or a knocked-out tooth, call our 24/7 Emergency Line immediately at <strong>+254 703 222 228</strong>. For a knocked-out permanent tooth, place it in cold fresh milk or inside your cheek without touching the root, and reach our clinic right away—timing within 60 minutes is critical to save the tooth.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

